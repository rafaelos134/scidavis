# Editor settings shared by all contributors, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,c}]
indent_style = space
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.{py,sip}]
indent_style = space
indent_size = 4

[*.{qss,qrc,ui,xml,yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,ts}]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
